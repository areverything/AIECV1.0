# Copy to .env.local for local development:
#   cp .env.local.example .env.local

# Browser -> Next.js /api proxy (this origin) -> agent server.
# Must be ABSOLUTE. A relative "/api" makes useStream's internal `new URL()`
# throw "Failed to construct 'URL': Invalid URL".
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# The /api passthrough route (app/api/[...path]/route.ts) forwards to this.
# Local agent server:  http://localhost:2024
# Deployed LangSmith:  https://your-deployment.us.langgraph.app
LANGGRAPH_API_URL=http://localhost:2024

# Leave empty for a local `langgraph dev` server (no key needed).
# Set only when LANGGRAPH_API_URL points at a deployed LangSmith URL.
LANGSMITH_API_KEY=
